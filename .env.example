# Supabase
# supabase.com → Project Settings → API'den kopyala
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (Vercel'de Production + Preview scope'a koy, Development'a koyma)
# Supabase Dashboard → Project Settings → API → service_role key
# UYARI: Bu key DB'de tüm RLS'i bypass eder. Asla client'a sızmamalı.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URL (production'da değiştir)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI sohbet asistanı (server-only)
ANTHROPIC_API_KEY=your-anthropic-key

# Chatbot RAG embeddings (opsiyonel — yoksa BM25-only arama çalışır)
OPENAI_API_KEY=

# Chatbot admin API (panel köprüsü) — panel'deki CHATBOT_ADMIN_TOKEN ile AYNI olmalı
# Üret: openssl rand -hex 32 · Boşsa /api/chatbot-admin/* endpoint'leri 404 döner
CHATBOT_ADMIN_TOKEN=

# Yazışma kaydında IP hash tuzu (KVKK — ham IP saklanmaz)
IP_HASH_SALT=

# Lead e-posta bildirimi (Resend — kirmizierik.com.tr domain'i doğrulanmış olmalı)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Kırmızı Erik <bildirim@kirmizierik.com.tr>
LEAD_NOTIFICATION_TO=ozkan@kirmizierik.com.tr

# Lead WhatsApp bildirimi (CallMeBot — boşsa atlanır)
# Aktivasyon: +34 644 51 95 23'e WhatsApp'tan "I allow callmebot to send me messages"
CALLMEBOT_PHONE=+905xxxxxxxxx
CALLMEBOT_APIKEY=
